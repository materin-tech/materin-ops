<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.materin</groupId>
        <artifactId>materin-ops-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>materin-ops-server</artifactId>
    <name>materin-ops-server</name>
    <description>后端启动模块：启动类、配置、Flyway 迁移</description>

    <dependencies>
        <dependency>
            <groupId>com.materin</groupId>
            <artifactId>materin-ops-components-ops</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.materin</groupId>
            <artifactId>materin-ops-components-developer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.materin</groupId>
            <artifactId>materin-ops-components-notice</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.materin</groupId>
            <artifactId>materin-ops-components-resource-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.materin</groupId>
            <artifactId>materin-ops-components-resource-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.materin</groupId>
            <artifactId>materin-ops-components-ticket</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>materin-ops-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
