      <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="05 APP 签名调用（正向 GET，断言 code=0）">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
import java.security.MessageDigest

def post(url, admin, payload) {
    def c = new URL(url).openConnection()
    c.requestMethod = 'POST'
    c.doOutput = true
    c.setRequestProperty('Authorization', 'Bearer ' + admin)
    c.setRequestProperty('Content-Type', 'application/json')
    c.outputStream.bytes = payload.getBytes('UTF-8')
    return new groovy.json.JsonSlurper().parse(c.inputStream)
}
def put(url, admin, payload) {
    def c = new URL(url).openConnection()
    c.requestMethod = 'PUT'
    c.doOutput = true
    c.setRequestProperty('Authorization', 'Bearer ' + admin)
    c.setRequestProperty('Content-Type', 'application/json')
    c.outputStream.bytes = payload.getBytes('UTF-8')
    return new groovy.json.JsonSlurper().parse(c.inputStream)
}
def getJson(url, admin) {
    def c = new URL(url).openConnection()
    c.requestMethod = 'GET'
    c.setRequestProperty('Authorization', 'Bearer ' + admin)
    return new groovy.json.JsonSlurper().parse(c.inputStream)
}

def host = props.get('host')
def port = props.get('port')
def ADMIN = vars.get('token')
def apiBase = 'http://' + host + ':' + port + '/api'

// 1. 取或建 APP
def list = getJson(apiBase + '/developer/apps?pageSize=1', ADMIN)
def appKey, appSecret, appId
if (list.data.total &gt; 0) {
    appKey = list.data.list[0].appKey
    appSecret = list.data.list[0].appSecret
    appId = list.data.list[0].id
} else {
    def created = post(apiBase + '/developer/apps', ADMIN, '{"name":"JMETER-APP"}')
    appKey = created.data.appKey
    appSecret = created.data.appSecret
    appId = created.data.id
}

// 2. 目标接口：开放 + 授权
def apiList = getJson(apiBase + '/developer/apis?pageSize=500', ADMIN)
def target = apiList.data.list.find { it.method == 'GET' &amp;&amp; it.path == '/requirement/products' }
if (target.status != 1) {
    put(apiBase + '/developer/apis/' + target.id, ADMIN, '{"status":1}')
}
def g = getJson(apiBase + '/developer/auth/apps/' + appId + '/apis', ADMIN)
if (!g.data.authorizedApiIds.contains(target.id)) {
    put(apiBase + '/developer/auth/apps/' + appId + '/apis', ADMIN, '[' + target.id + ']')
}

// 3. HMAC-SHA256 签名（签名串用后端路径，不带 /api 前缀）
def method = 'GET'
def path = '/requirement/products'
def ts = String.valueOf(System.currentTimeMillis())
def nonce = UUID.randomUUID().toString()
def bh = MessageDigest.getInstance('SHA-256').digest(''.getBytes('UTF-8')).encodeHex().toString()
def ss = String.join('\n', appKey, method, path, ts, nonce, bh)
def mac = Mac.getInstance('HmacSHA256')
mac.init(new SecretKeySpec(appSecret.getBytes('UTF-8'), 'HmacSHA256'))
def sig = mac.doFinal(ss.getBytes('UTF-8')).encodeHex().toString()

// 4. 调用（网关路径带 /api 前缀）
def conn = new URL('http://' + host + ':' + port + '/api' + path).openConnection()
conn.requestMethod = 'GET'
conn.setRequestProperty('X-App-Key', appKey)
conn.setRequestProperty('X-Timestamp', ts)
conn.setRequestProperty('X-Nonce', nonce)
conn.setRequestProperty('X-Signature', sig)
def code = conn.responseCode
def body = (code &lt; 400 ? conn.inputStream : conn.errorStream).getText('UTF-8')

def ok = (code == 200 &amp;&amp; body.contains('"code":0'))
SampleResult.setSuccessful(ok)
SampleResult.setResponseData('APP signed GET ' + path + ' -&gt; http=' + code + ' body=' + body.substring(0, Math.min(80, body.length())), 'UTF-8')
SampleResult.setResponseCode(String.valueOf(code))</stringProp>
      </JSR223Sampler>
